# Data - raw Census downloads (regenerated by scripts/prepare_data.py)
data/raw/

# State (data/state.geojson ~350KB), county (data/county.geojson ~2.3MB), tract geometry
# (data/tract.fgb, geometry+GEOID only, size-capped), tract attributes
# (data/tract_values.parquet), and the precomputed adjacency caches (data/cache/*.pkl) are
# all generated by scripts/prepare_data.py and committed to git so the deployed app never
# has to rebuild them at runtime. Run: python scripts/prepare_data.py
